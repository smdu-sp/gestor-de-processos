DATABASE_URL="mysql://gestao:configure-no-env@127.0.0.1:3307/gestao_processos"
MYSQL_DATABASE="gestao_processos"
MYSQL_USER="gestao"
MYSQL_PORT="3307"
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
DEMO_MODE="true"
SEED_PASSWORD="troque-esta-senha-local"
# local: senha do banco; ldap: credenciais de rede via SMUL Auth.
AUTH_MODE="local"
# Login (AUTH_MODE=ldap) e busca de servidores por login na tela Servidores.
SMUL_AUTH_API_URL="http://api.smul.pmsp"
# BI: driver/consulta pendentes de identificação do banco e views.
# Não reutilizar DATABASE_URL: ela é exclusiva do banco operacional.
BI_DB_PROVIDER=""
BI_DATABASE_URL=""
# SEI SOAP 4.1. Chave de acesso somente no servidor, nunca no chat/NEXT_PUBLIC.
SEI_WSDL_URL="https://sei.prefeitura.sp.gov.br/sei/controlador_ws.php?servico=sei"
SEI_ENDPOINT_URL=""
SEI_SIGLA_SISTEMA=""
SEI_IDENTIFICACAO_SERVICO=""
SEI_ID_UNIDADE=""
SEI_UTC_OFFSET="-03:00"
# IDs oficiais, separados por vírgula. Vazio consulta apenas marcos/último andamento.
SEI_TAREFAS=""
SEI_TAREFAS_MODULOS=""
